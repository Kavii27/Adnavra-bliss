# Copy this to .env and fill in real values — never commit .env
# See .env in your local clone for the development database string.

# --- Database ---
# Hosted Postgres — Neon (pooled) or Supabase (pooled + direct)
# Supabase needs both DATABASE_URL (pooled, port 6543) and DIRECT_URL (direct, port 5432)
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"
DIRECT_URL="postgresql://user:password@host:5432/dbname?schema=public"

# --- Auth.js ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-random-secret-at-least-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# --- Rate limiting (production — Upstash Redis) ---
# Leave empty for local dev (falls back to in-memory limiter in src/lib/rate-limit.ts)
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# --- Booking notifications (Phase 4.5 — Resend for email) ---
# Get a key at https://resend.com/api-keys and verify bookings@adnavra.lk as a sender.
# Leave empty for local dev — notification sends are skipped silently, bookings still work.
# RESEND_API_KEY=""
# Public base URL used to build dashboard links inside notification emails.
# NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Google OAuth (Phase 6 — optional) ---
# Create a Google Cloud OAuth 2.0 Client ID (https://console.cloud.google.com/apis/credentials)
# Set Authorized redirect URI to: https://yourdomain.com/api/auth/callback/google
# For local dev: http://localhost:3000/api/auth/callback/google
# Leave empty until the founder has a client — the app works without it (Google button stays disabled).
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
